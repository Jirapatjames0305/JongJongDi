# Database (Supabase Session Pooler)
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres?pgbouncer=true"

# API
API_PORT=4000
JWT_SECRET="change-me-to-random-secret-min-32-chars"

# App URLs (used by API for redirects / links)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_ADMIN_URL="http://localhost:3001"

# Supabase Storage — used for payment slip + image uploads.
# URL + service_role key from Supabase dashboard → Settings → API.
# Bucket must exist and be public (Storage → New bucket → "Public").
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_BUCKET="jongjongdi-uploads"

# ChillPay (hosted payment gateway) — from your ChillPay merchant dashboard.
CHILLPAY_MERCHANT_CODE=""
CHILLPAY_API_KEY=""
CHILLPAY_MD5_SECRET=""
# Sandbox: https://sandbox-cdn.chillpay.co/Payment/  |  Production: https://cdn.chillpay.co/Payment/
CHILLPAY_PAYMENT_URL="https://sandbox-cdn.chillpay.co/Payment/"
# Where the browser returns after payment (web app URL)
CHILLPAY_RETURN_BASE="http://localhost:3000"
# Public URL ChillPay calls server-to-server with the result (must be reachable by ChillPay)
CHILLPAY_NOTIFY_URL="http://localhost:4000/api/webhooks/chillpay"

# Resend Email — used for booking confirmation emails.
# Get API key from https://resend.com → API Keys.
RESEND_API_KEY="re_..."
EMAIL_FROM="noreply@jongjongdi.com"
