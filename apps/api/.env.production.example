# Copy this to .env.production and fill in the values
# cp .env.production.example .env.production

# Database (same as .env)
DATABASE_URL="postgresql://..."

# API
API_PORT=4000
JWT_SECRET="<CHANGE-TO-STRONG-RANDOM-SECRET>"

# App URLs — change to your domain or EC2 IP
NEXT_PUBLIC_SITE_URL="http://<EC2_IP>"
NEXT_PUBLIC_ADMIN_URL="http://<EC2_IP>/admin"

# Supabase Storage (same as .env)
SUPABASE_URL="https://yvaoxbmqwtvqwlwzqtsg.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="<from .env>"
SUPABASE_BUCKET="jongjongdi-uploads"

# ChillPay — switch to production URL when ready
CHILLPAY_MERCHANT_CODE="M038321"
CHILLPAY_API_KEY="<from .env>"
CHILLPAY_MD5_SECRET="<from .env>"
CHILLPAY_PAYMENT_URL="https://cdn.chillpay.co/Payment/"
CHILLPAY_RETURN_BASE="http://<EC2_IP>"
CHILLPAY_NOTIFY_URL="http://<EC2_IP>:4000/api/webhooks/chillpay"

# Resend (same as .env)
RESEND_API_KEY="<from .env>"
EMAIL_FROM="noreply@jongjongdi.com"
